% ── 4. Experiments ────────────────────────────────────
\section{Experiments}

\subsection{Setup}

\paragraph{Dataset.}
We evaluate on an industrial anomaly detection dataset with 51,648 training images and 1,000 validation images (555 with defects, 445 clean).
Defect types include Pitting, Scratches, Corrosion, and others.
The validation set contains 798 ground-truth defect boxes.

\paragraph{Metrics.}
We report:
\begin{itemize}[leftmargin=*]
    \item Recall@IoU=$\tau$: Percentage of ground-truth boxes matched at IoU threshold $\tau$
    \item Classification Accuracy: Type classification accuracy for matched detections
    \item Defect Accuracy: Binary classification accuracy (defect vs. clean)
\end{itemize}

\paragraph{Baselines.}
The SFT baseline is a Qwen2.5-VL-7B model fine-tuned on the IAD dataset for 2,828 steps.

